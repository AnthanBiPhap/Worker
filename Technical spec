--text-4xl:  2.25rem;    /* 36px — H2 */
--text-5xl:  3rem;       /* 48px — H1 */
--text-6xl:  3.75rem;    /* 60px — Display (desktop hero) */
--text-7xl:  4.5rem;     /* 72px — Super display (desktop only) */

/* === LINE HEIGHT === */
--leading-tight:   1.25;
