  read_time_min   INTEGER,               -- Ước tính thời gian đọc
  tags            TEXT[] DEFAULT '{}',
  meta_title      TEXT,
  meta_description TEXT,
  meta_keywords   TEXT,
  og_image_url    TEXT,
  canonical_url   TEXT,
  search_vector   TSVECTOR,
  created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
)
```

### 6.8 Table: `leads`

```sql
leads (
  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  full_name       TEXT NOT NULL,
  phone           TEXT NOT NULL,
  email           TEXT,
  company         TEXT,
  lead_type       TEXT NOT NULL DEFAULT 'individual'
                  CHECK (lead_type IN ('individual', 'business', 'architect')),
  source          TEXT,                   -- "homepage_form", "chat", "product_page", "blog"
  source_url      TEXT,
  product_interest UUID REFERENCES products(id),
  project_description TEXT,
  budget_range    TEXT,
  area_size       TEXT,
  location        TEXT,
  status          TEXT NOT NULL DEFAULT 'new'
                  CHECK (status IN ('new', 'contacted', 'qualified', 'proposal_sent',
                                    'negotiating', 'won', 'lost', 'spam')),
  priority        TEXT NOT NULL DEFAULT 'normal'
                  CHECK (priority IN ('low', 'normal', 'high', 'urgent')),
  assigned_to     UUID REFERENCES profiles(id),
  notes           TEXT,
  chat_session_id TEXT,                   -- Liên kết với chat session
  utm_source      TEXT,
  utm_medium      TEXT,
  utm_campaign    TEXT,
  created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
  updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
)
```

