--space-32:  8rem;     /* 128px */

/* === SECTION PADDING === */
--section-padding-y-sm:   var(--space-12);   /* 48px — mobile */
--section-padding-y-md:   var(--space-16);   /* 64px — tablet */
--section-padding-y-lg:   var(--space-24);   /* 96px — desktop */
